# Paste inside the existing server block OR replace this site's proxy .conf.
# Keep the BaoTa server's listen, domain, certificate and ACME settings.
# Use ONE root proxy location; remove the old root proxy/static-cache locations.
include /www/server/panel/vhost/nginx/sorvflow-backend.inc;

location / {
    client_max_body_size 8m;
    proxy_pass http://$sorvflow_backend;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_cache off;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
}
