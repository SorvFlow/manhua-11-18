# Model provider. Replace these placeholders in /etc/sorvflow/sorvflow.env.
PROVIDER=openai_compat
OPENAI_COMPAT_BASE_URL=https://image-provider.example/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL_T2I=your-text-to-image-model
OPENAI_COMPAT_MODEL_I2I=your-image-to-image-model
OPENAI_COMPAT_CHAT_BASE_URL=https://text-provider.example/v1
OPENAI_COMPAT_CHAT_API_KEY=
OPENAI_COMPAT_CHAT_MODEL=your-tool-calling-chat-model

# Application storage and initial low-concurrency settings.
INKSTONE_DATA_DIR=/var/lib/sorvflow/data
INKSTONE_EXPERIMENTS_DIR=/var/lib/sorvflow/data/experiments
# The installer fills the detected font path; leave blank to use application discovery.
INKSTONE_FONT_PATH=
INKSTONE_IMAGE_CONCURRENCY=1
INKSTONE_UI_MAX_BODY_BYTES=8388608

# Do not enable public binding. Nginx reaches the loopback-only service.
INKSTONE_UI_HOST=127.0.0.1

# Optional comic defaults. Tune after measuring your chosen model and server.
INKSTONE_RENDER_MODE=panel_compose
INKSTONE_LETTERING=1
INKSTONE_GENRE=wuxia
INKSTONE_PANEL_SIZE=1024x1024
INKSTONE_PAGE_SIZE=1024x1536

# Application accounts and persistent queue (public origin must match the browser).
# Fill your actual HTTPS domain before accessing from the internet.
SORVFLOW_PUBLIC_URL=
SORVFLOW_STATE_DIR=/var/lib/sorvflow/web
# Global active jobs; image concurrency below applies inside EACH worker.
SORVFLOW_WORKERS=1
SORVFLOW_USER_RUNNING=1
SORVFLOW_USER_QUEUED=5
SORVFLOW_SESSION_HOURS=12
